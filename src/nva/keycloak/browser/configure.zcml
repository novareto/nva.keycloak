<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="nva.keycloak"
    >

  <!-- Set overrides folder for Just-a-Bunch-Of-Templates product -->
  <include
      package="z3c.jbot"
      file="meta.zcml"
      />
  <browser:jbot
      directory="overrides"
      layer="nva.keycloak.interfaces.INvaKeycloakLayer"
      />

  <!-- Publish static files -->
  <plone:static
      directory="static"
      name="nva.keycloak"
      type="plone"
      />

  <plone:service
      method="GET"
      factory=".service.Health"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="health"
      />

  <plone:service
      method="GET"
      factory=".service.KeyCloakUsers"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="users"
      />

  <plone:service
      method="POST"
      factory=".service.KeyCloakCreateUser"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="users"
      />

  <plone:service
      method="PUT"
      factory=".service.KeyCloakUpdateUser"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="users"
      />

  <plone:service
      method="DELETE"
      factory=".service.KeyCloakDeleteUser"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="users"
      />

  <plone:service
      method="POST"
      factory=".service.KeyCloakCredentials"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="credentials"
      />

  <plone:service
      method="PUT"
      factory=".service.KeyCloakUpdateCredentials"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="credentials"
      />

</configure>
